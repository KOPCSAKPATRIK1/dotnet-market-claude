{
  "name": "dotnet-ai-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Claude Code marketplace: contract + convention kit for .NET projects.",
  "type": "module",
  "bin": {
    "kit-dotnet": "packs/kit-dotnet/bin/kit-dotnet"
  },
  "scripts": {
    "sync": "node tools/kit.mjs sync",
    "sync:check": "node tools/kit.mjs sync --check",
    "verify": "node tools/kit.mjs verify",
    "new": "node tools/kit.mjs new",
    "hooks": "git config core.hooksPath tools/hooks"
  },
  "engines": {
    "node": ">=20"
  }
}
